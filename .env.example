# --- Site -------------------------------------------------------------
# Public URL. Use the real https domain in production: robots.txt only allows
# indexing when this is an https URL (staging/localhost are kept out of Google).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional: API URL reachable from the Next.js server (e.g. inside Docker) for server rendering.
API_URL_INTERNAL=

# --- Contact (shown on the site and in Google structured data) ---------
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_WHATSAPP_URL=
# schema.org hours, comma-separated, e.g. "Mo-Fr 09:00-15:30, Sa 09:00-12:30"
NEXT_PUBLIC_OPENING_HOURS=
# Exact map pin from your Google Business Profile (improves local SEO)
NEXT_PUBLIC_GEO_LAT=
NEXT_PUBLIC_GEO_LNG=

# --- Social profiles -----------------------------------------------------
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Search console verification ----------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Images ------------------------------------------------------------
# Hostnames of CMS image storage that next/image may optimize (comma-separated),
# e.g. "pub-xxxx.r2.dev,cdn.littlemahilam.in". Other hosts are served unoptimized.
NEXT_PUBLIC_IMAGE_HOSTS=
